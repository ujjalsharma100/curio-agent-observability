# Curio Agent SDK Observability - Environment Variables
# Copy this file to .env and configure as needed

# ============== Observability Server ==============
OBSERVABILITY_PORT=5050
OBSERVABILITY_DEBUG=true

# ============== Database Configuration ==============
# Choose one: sqlite, postgres, or memory
DB_TYPE=sqlite

# SQLite (default for development)
DB_PATH=../agent_sdk.db

# PostgreSQL (for production)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=agent_sdk
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_SCHEMA=agent_sdk
# DB_MIN_CONNECTIONS=1
# DB_MAX_CONNECTIONS=10

# ============== React Frontend ==============
# The frontend runs on port 3000 by default and proxies API calls to the backend
# REACT_APP_API_URL=http://localhost:5050
